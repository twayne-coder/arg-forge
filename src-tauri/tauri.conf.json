{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ArgForge",
  "version": "1.1.3",
  "identifier": "com.ctw.arg-forge",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ArgForge",
        "width": 1000,
        "height": 700,
        "minWidth": 800,
        "minHeight": 550,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "acceptFirstMouse": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "twayne-coder",
    "homepage": "https://github.com/twayne-coder/arg-forge"
  }
}